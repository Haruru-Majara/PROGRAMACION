public class Uno {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		//Los comentarios en java de dos barras oblicuas comentan toda la línea
		System.out.println("Este es el número uno");
		System.out.println(" ");
		//variables enteros : byte, short, int, long
		//variables con coma: float, double
		
		int numero1=7; //declaracion de variable entera + guardado de valor
		int numero2,sumaTotal; //solo declaracion de variable
		double producto,numero3=2.3,division;
		char letra='A';
		
		numero2=4; // guardado de valor
		sumaTotal=numero1+numero2; // suma de variables
		
		System.out.println("Valor de 1: "+numero1);
		System.out.println("Valor de 2: "+numero2);
		System.out.println("La suma es: "+sumaTotal);
		
		producto=numero1*numero3;
		System.out.println("Valor de numero1:\t"+numero1); // \t tabula
		System.out.println("Valor de b:\n"+numero2); // \n salta de linea
		System.out.println("El producto es: "+producto);
		
		division=numero1/numero2;
		System.out.println("La división entre numero1 y numero2 es: "+division);
		//Si los numero que divides son enteros, aunque la variable donde lo guardes es double o float, el resultado es entero
		
		System.out.println("La letra es: "+letra);
		//variables booleanos: boolean
		//
		
	}

}
